---
import { CameraIcon } from "lucide-react";
import "../styles/global.css";
import Layout from "@/layouts/Layout.astro";
const API_URL =
  "https://pokemon-api-production-be3a.up.railway.app/identificar";
---

<Layout>
  <div class="flex flex-col h-dvh min-h-screen gap-4 sm:gap-8 mt-4 sm:mt-8">
    <div class="sticky top-0 z-10 bg-background/95 backdrop-blur-xs">
      <div class="felx flex-col gap-4 sm:gap-8">
        <h1 class="text-3xl">Pokédex</h1>
        <div class="flex">
          <a href="#">
            <CameraIcon />
          </a>
        </div>
      </div>
    </div>
    <!-- Pokédex frame -->
    <div class="pokedex">
      <!-- Pantalla principal -->
      <div class="screen-area">
        <div class="screen-border">
          <div class="screen" id="screen">
            <video id="video" autoplay playsinline muted></video>
            <canvas id="canvas" style="display:none"></canvas>

            <!-- Overlay de flash -->
            <div class="flash" id="flash"></div>

            <!-- Retícula -->
            <div class="reticle" id="reticle">
              <span class="corner tl"></span>
              <span class="corner tr"></span>
              <span class="corner bl"></span>
              <span class="corner br"></span>
            </div>

            <!-- Estado de análisis -->
            <div class="analyzing" id="analyzing" style="display:none">
              <div class="scan-line"></div>
              <p class="analyzing-text">ANALIZANDO...</p>
            </div>

            <!-- Foto congelada overlay -->
            <img
              id="frozen-img"
              style="display:none; position:absolute; inset:0; width:100%; height:100%; object-fit:cover;"
            />
          </div>
        </div>

        <!-- Luces decorativas -->
        <div class="lights">
          <div class="light red" id="light-red"></div>
          <div class="light yellow"></div>
          <div class="light green"></div>
        </div>
      </div>

      <!-- Resultado -->
      <div class="result-area" id="result-area" style="display:none">
        <div class="result-screen">
          <p class="result-label">POKÉMON DETECTADO</p>
          <p class="result-name" id="result-name">—</p>
          <div class="result-bar">
            <div class="result-fill" id="result-fill"></div>
          </div>
          <p class="result-score" id="result-score">0%</p>
          <div class="result-top3" id="result-top3"></div>
        </div>
      </div>

      <!-- Botón -->
      <div class="controls">
        <button class="btn-capture" id="btn-capture" disabled>
          <span class="btn-inner">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <circle
                cx="12"
                cy="12"
                r="9"
                stroke="currentColor"
                stroke-width="2"></circle>
              <circle cx="12" cy="12" r="5" fill="currentColor"></circle>
            </svg>
            IDENTIFICAR
          </span>
        </button>
        <button class="btn-retry" id="btn-retry" style="display:none">
          ↩ VOLVER A ESCANEAR
        </button>
      </div>
    </div>
  </div>

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323:wght@400&display=swap");

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    .scanner-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      background: #1a0a2e;
      background-image:
        radial-gradient(ellipse at 20% 50%, #2d1b69 0%, transparent 50%),
        radial-gradient(ellipse at 80% 20%, #0d2137 0%, transparent 50%);
      padding: 20px;
      font-family: "Press Start 2P", monospace;
    }

    .pokedex {
      width: 100%;
      max-width: 380px;
      background: linear-gradient(145deg, #cc1111, #ee2222);
      border-radius: 16px 16px 12px 12px;
      padding: 20px;
      box-shadow:
        0 0 0 3px #880000,
        0 20px 60px rgba(0, 0, 0, 0.6),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
      position: relative;
    }

    .pokedex::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 50%;
      background: linear-gradient(145deg, #dd2222, #cc1111);
      border-radius: 16px 16px 0 0;
      pointer-events: none;
    }

    /* Pantalla */
    .screen-area {
      position: relative;
      z-index: 1;
    }

    .lights {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
      align-items: center;
    }

    .light {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      border: 2px solid rgba(0, 0, 0, 0.3);
    }

    .light.red {
      background: #ff4444;
      box-shadow: 0 0 8px #ff4444;
      width: 24px;
      height: 24px;
    }

    .light.red.blink {
      animation: blink 0.4s ease-in-out infinite;
    }

    .light.yellow {
      background: #ffcc00;
    }
    .light.green {
      background: #44ff44;
      box-shadow: 0 0 6px #44ff44;
    }

    @keyframes blink {
      0%,
      100% {
        box-shadow: 0 0 8px #ff4444;
        opacity: 1;
      }
      50% {
        box-shadow: 0 0 20px #ff6666;
        opacity: 0.6;
      }
    }

    .screen-border {
      background: #222;
      border-radius: 8px;
      padding: 6px;
      box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.8);
    }

    .screen {
      position: relative;
      width: 100%;
      aspect-ratio: 4/3;
      background: #000;
      border-radius: 4px;
      overflow: hidden;
    }

    #video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Flash */
    .flash {
      position: absolute;
      inset: 0;
      background: white;
      opacity: 0;
      pointer-events: none;
      z-index: 10;
    }

    .flash.go {
      animation: flash 0.4s ease-out forwards;
    }

    @keyframes flash {
      0% {
        opacity: 1;
      }
      100% {
        opacity: 0;
      }
    }

    /* Retícula */
    .reticle {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 5;
    }

    .corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border-color: #00ffcc;
      border-style: solid;
      opacity: 0.8;
    }

    .tl {
      top: 12px;
      left: 12px;
      border-width: 2px 0 0 2px;
    }
    .tr {
      top: 12px;
      right: 12px;
      border-width: 2px 2px 0 0;
    }
    .bl {
      bottom: 12px;
      left: 12px;
      border-width: 0 0 2px 2px;
    }
    .br {
      bottom: 12px;
      right: 12px;
      border-width: 0 2px 2px 0;
    }

    /* Línea de scan */
    .analyzing {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 8;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
    }

    .scan-line {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, #00ffcc, transparent);
      box-shadow: 0 0 12px #00ffcc;
      animation: scan 1.2s ease-in-out infinite;
    }

    @keyframes scan {
      0% {
        top: 0%;
      }
      100% {
        top: 100%;
      }
    }

    .analyzing-text {
      font-family: "VT323", monospace;
      font-size: 28px;
      color: #00ffcc;
      text-shadow: 0 0 10px #00ffcc;
      animation: pulse 0.8s ease-in-out infinite;
      letter-spacing: 2px;
      z-index: 1;
    }

    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.4;
      }
    }

    /* Resultado */
    .result-area {
      margin-top: 12px;
    }

    .result-screen {
      background: #0a1a0a;
      border: 2px solid #00aa44;
      border-radius: 6px;
      padding: 16px;
      text-align: center;
      box-shadow:
        inset 0 0 20px rgba(0, 255, 100, 0.05),
        0 0 10px rgba(0, 170, 68, 0.3);
      animation: fadeIn 0.4s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .result-label {
      font-size: 7px;
      color: #006622;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .result-name {
      font-size: 20px;
      color: #00ff66;
      text-shadow: 0 0 10px #00ff66;
      text-transform: uppercase;
      margin-bottom: 12px;
      font-family: "VT323", monospace;
      font-size: 36px;
      letter-spacing: 2px;
    }

    .result-bar {
      background: #001a00;
      height: 8px;
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 6px;
      border: 1px solid #004400;
    }

    .result-fill {
      height: 100%;
      background: linear-gradient(90deg, #00aa44, #00ff66);
      box-shadow: 0 0 6px #00ff66;
      width: 0%;
      transition: width 0.8s ease-out;
      border-radius: 4px;
    }

    .result-score {
      font-size: 9px;
      color: #00aa44;
      margin-bottom: 10px;
    }

    .result-top3 {
      font-family: "VT323", monospace;
      font-size: 16px;
      color: #005522;
      line-height: 1.6;
      border-top: 1px solid #002211;
      padding-top: 8px;
      margin-top: 4px;
    }

    /* Controles */
    .controls {
      margin-top: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      z-index: 1;
    }

    .btn-capture {
      background: linear-gradient(145deg, #ffdd00, #ffaa00);
      border: none;
      border-radius: 8px;
      padding: 14px;
      cursor: pointer;
      box-shadow:
        0 4px 0 #aa6600,
        0 6px 12px rgba(0, 0, 0, 0.4);
      transition: all 0.1s;
      font-family: "Press Start 2P", monospace;
      font-size: 10px;
      color: #3a1a00;
      width: 100%;
    }

    .btn-capture:hover:not(:disabled) {
      background: linear-gradient(145deg, #ffee22, #ffbb00);
      transform: translateY(-1px);
      box-shadow:
        0 5px 0 #aa6600,
        0 8px 16px rgba(0, 0, 0, 0.4);
    }

    .btn-capture:active:not(:disabled) {
      transform: translateY(3px);
      box-shadow:
        0 1px 0 #aa6600,
        0 2px 6px rgba(0, 0, 0, 0.4);
    }

    .btn-capture:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .btn-retry {
      background: transparent;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-radius: 8px;
      padding: 10px;
      cursor: pointer;
      font-family: "Press Start 2P", monospace;
      font-size: 8px;
      color: rgba(255, 255, 255, 0.7);
      transition: all 0.2s;
      width: 100%;
    }

    .btn-retry:hover {
      border-color: rgba(255, 255, 255, 0.7);
      color: white;
      background: rgba(255, 255, 255, 0.05);
    }

    /* Error */
    .error-msg {
      font-family: "VT323", monospace;
      font-size: 18px;
      color: #ff4444;
      text-align: center;
      padding: 8px;
    }
  </style>

  <script define:vars={{ API_URL }}>
    const video = document.getElementById("video");
    const canvas = document.getElementById("canvas");
    const flash = document.getElementById("flash");
    const reticle = document.getElementById("reticle");
    const analyzing = document.getElementById("analyzing");
    const frozenImg = document.getElementById("frozen-img");
    const resultArea = document.getElementById("result-area");
    const resultName = document.getElementById("result-name");
    const resultFill = document.getElementById("result-fill");
    const resultScore = document.getElementById("result-score");
    const resultTop3 = document.getElementById("result-top3");
    const btnCapture = document.getElementById("btn-capture");
    const btnRetry = document.getElementById("btn-retry");
    const lightRed = document.getElementById("light-red");

    // Iniciar cámara
    navigator.mediaDevices
      .getUserMedia({ video: { facingMode: "environment" } })
      .then((stream) => {
        video.srcObject = stream;
        btnCapture.disabled = false;
      })
      .catch(() => {
        // Fallback a cámara frontal
        navigator.mediaDevices.getUserMedia({ video: true }).then((stream) => {
          video.srcObject = stream;
          btnCapture.disabled = false;
        });
      });

    btnCapture.addEventListener("click", async () => {
      // 1. Flash
      flash.classList.add("go");
      setTimeout(() => flash.classList.remove("go"), 400);

      // 2. Congelar imagen
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      canvas.getContext("2d").drawImage(video, 0, 0);
      const dataUrl = canvas.toDataURL("image/jpeg", 0.9);
      frozenImg.src = dataUrl;
      frozenImg.style.display = "block";
      video.style.display = "none";

      // 3. Mostrar análisis
      reticle.style.display = "none";
      analyzing.style.display = "flex";
      lightRed.classList.add("blink");
      btnCapture.style.display = "none";

      // 4. Llamar a la API
      try {
        canvas.toBlob(
          async (blob) => {
            const formData = new FormData();
            formData.append("file", blob, "foto.jpg");

            const res = await fetch(API_URL, {
              method: "POST",
              body: formData,
            });
            const data = await res.json();

            // 5. Mostrar resultado
            analyzing.style.display = "none";
            lightRed.classList.remove("blink");
            resultArea.style.display = "block";
            btnRetry.style.display = "block";

            const top = data.predicciones[0];
            const nombre =
              top.label.charAt(0).toUpperCase() +
              top.label.slice(1).replace(/-/g, " ");
            const pct = Math.round(top.score * 100);

            resultName.textContent = nombre;
            resultScore.textContent = `${pct}% de confianza`;
            setTimeout(() => {
              resultFill.style.width = `${pct}%`;
            }, 100);

            // Top 3
            resultTop3.innerHTML = data.predicciones
              .slice(1, 3)
              .map((p) => {
                const n =
                  p.label.charAt(0).toUpperCase() +
                  p.label.slice(1).replace(/-/g, " ");
                const s = Math.round(p.score * 100);
                return `<div>${n} — ${s}%</div>`;
              })
              .join("");
          },
          "image/jpeg",
          0.9,
        );
      } catch (err) {
        analyzing.style.display = "none";
        lightRed.classList.remove("blink");
        resultArea.style.display = "block";
        resultName.innerHTML = `<span class="error-msg">ERROR DE CONEXIÓN</span>`;
        btnRetry.style.display = "block";
      }
    });

    // Volver a escanear
    btnRetry.addEventListener("click", () => {
      frozenImg.style.display = "none";
      video.style.display = "block";
      reticle.style.display = "block";
      analyzing.style.display = "none";
      resultArea.style.display = "none";
      btnCapture.style.display = "block";
      btnRetry.style.display = "none";
      resultFill.style.width = "0%";
      resultTop3.innerHTML = "";
    });
  </script>
</Layout>
