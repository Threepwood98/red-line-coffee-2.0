---
import {
  CoffeeIcon,
  HouseIcon,
  UserIcon,
  StoreIcon,
  Gamepad2Icon,
} from "lucide-react";
import { IconPokeball } from "@tabler/icons-react";

const navItems = [
  { link: "/", icon: HouseIcon, label: "Home" },
  { link: "/menu", icon: CoffeeIcon, label: "Menú" },
  { link: "/store", icon: StoreIcon, label: "Tienda" },
  { link: "/ps4", icon: Gamepad2Icon, label: "PS4" },
  { link: "/pokedex", icon: IconPokeball, label: "Pokédex" },
  // { link: "/auth/signin", icon: UserIcon, label: "Perfil" },
];
---

<nav
  class="fixed bottom-0 z-10 flex w-full h-16 py-4 items-center justify-around bg-primary-foreground"
>
  {
    navItems.map((item) => {
      const Icon = item.icon;
      return (
        <a
          href={item.link}
          class="flex flex-col items-center text-neutral-600 hover:text-primary dark:text-neutral-400 dark:hover:text-primary transition-colors"
        >
          <Icon />
          <span class="text-sm font-medium">{item.label}</span>
        </a>
      );
    })
  }
</nav>
